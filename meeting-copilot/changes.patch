+async function captureQuietScreenshot() {
+  const directory = await fs.promises.mkdtemp(path.join(os.tmpdir(), "meeting-copilot-shot-"));
+  const file = path.join(directory, "screen.png");
+  try {
+    const executable = path.join(process.resourcesPath, "tools", "QuietCapture.exe");
+    await new Promise((resolve, reject) => {
+      child_process.execFile(executable, ["--capture-once", file], { windowsHide: true, timeout: 15000 }, (error) => error ? reject(error) : resolve());
+    });
+    const image = await fs.promises.readFile(file);
+    return "data:image/png;base64," + image.toString("base64");
+  } finally {
+    await fs.promises.rm(file, { force: true });
+    await fs.promises.rmdir(directory);
+  }
+}
