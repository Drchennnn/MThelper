+    if (!endpoints.length) throw new Error('请在设置的“视觉模型”中配置至少一个接口');
+    if (options.answerMode && (options.simultaneousAnswers ?? state.simultaneousAnswers) === true) {
+      const onResult = result => { if (!signal?.aborted) options.onResult?.(result); };
+      let completed = 0;
